---
import { withBase } from '../utils/url';

/*
 * Replaces the Weebly `wSlideshow` widget (jQuery + the 480 KB theme bundle).
 * The track is a native scroll-snap carousel: it swipes, scrolls and keyboard
 * -navigates with no JavaScript at all. The inline script only adds the
 * previous/next buttons and the 5s autoplay the old widget had, with the
 * pause control and stop-on-focus behaviour of the WAI-ARIA APG carousel.
 */
const photos = [
	{ url: '/uploads/8615128.jpg', width: 400, height: 277, alt: 'Barracuda a Sipadan' },
	{ url: '/uploads/9503612.jpg', width: 400, height: 266, alt: 'Tartaruga' },
	{ url: '/uploads/3230728.jpg', width: 400, height: 300, alt: 'Clownfish' },
	{ url: '/uploads/3089333.jpg', width: 400, height: 300, alt: 'Gamberetto e anemone' },
	{ url: '/uploads/2348789.jpg', width: 400, height: 266, alt: 'Gamberetto e corallo uva' },
	{ url: '/uploads/anemone.jpeg', width: 800, height: 600, alt: 'Anemone' },
	{ url: '/uploads/jack.jpeg', width: 800, height: 600, alt: 'Carangidi giganti' },
	{ url: '/uploads/mandarin.jpeg', width: 800, height: 600, alt: 'Mandarinfish' },
	{ url: '/uploads/boxfish.jpeg', width: 800, height: 600, alt: 'Pesce scatola cornuto' },
	{ url: '/uploads/cernia.jpeg', width: 800, height: 600, alt: 'Cernia' },
	{ url: '/uploads/clam.jpeg', width: 800, height: 600, alt: 'Mollusco bivalve col ciuffo' },
	{ url: '/uploads/clown.jpeg', width: 800, height: 600, alt: 'Clownfish' },
	{ url: '/uploads/flatworm.jpeg', width: 800, height: 600, alt: 'Verme piatto' },
	{ url: '/uploads/frog1.jpeg', width: 800, height: 600, alt: 'Frogfish' },
	{ url: '/uploads/frog2.jpeg', width: 800, height: 600, alt: 'Frogfish' },
	{ url: '/uploads/gamberetto1.jpeg', width: 800, height: 600, alt: 'Gamberetto del corallo frusta' },
	{ url: '/uploads/nudi.jpeg', width: 800, height: 600, alt: 'Nudibranco' },
	{ url: '/uploads/gamberetto2.jpeg', width: 800, height: 600, alt: 'Gamberetto' },
	{ url: '/uploads/gamberetto3.jpeg', width: 800, height: 600, alt: 'Gamberetto' },
	{ url: '/uploads/granchio.jpeg', width: 800, height: 600, alt: 'Granchio porcellana e anemone' },
	{ url: '/uploads/hammer.jpeg', width: 800, height: 600, alt: 'Squalo martello' },
	{ url: '/uploads/istrice.jpeg', width: 800, height: 600, alt: 'Pesce istrice e gamberetti' },
	{ url: '/uploads/nudi2.jpeg', width: 800, height: 600, alt: 'Nudibranco' },
	{ url: '/uploads/octopus.jpeg', width: 800, height: 600, alt: 'Occhio di un polpo' },
	{ url: '/uploads/pigmy.jpeg', width: 1024, height: 768, alt: 'Cavalluccio marino pigmeo' },
	{ url: '/uploads/scorfanetto.jpeg', width: 800, height: 600, alt: 'Scorfanetto' },
	{ url: '/uploads/scorfano.jpeg', width: 800, height: 600, alt: 'Scorfano' },
	{ url: '/uploads/seppia.jpeg', width: 800, height: 600, alt: 'Cuttlefish flamboyant' },
	{ url: '/uploads/tridacna.jpeg', width: 800, height: 600, alt: 'Tridacna' },];
---

<section class="photo-carousel" aria-roledescription="carousel" aria-label="Foto subacquee">
	<div class="carousel-track" tabindex="0" aria-label="Foto" aria-live="polite">
		{
			photos.map((photo, i) => (
				<div class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} di ${photos.length}`}>
					<img
						src={withBase(photo.url)}
						width={photo.width}
						height={photo.height}
						alt={photo.alt}
						loading={i === 0 ? 'eager' : 'lazy'}
						decoding="async"
					/>
					<p class="carousel-caption">{photo.alt}</p>
				</div>
			))
		}
	</div>
	<button class="carousel-toggle" type="button" aria-label="Metti in pausa le foto" hidden>&#10074;&#10074;</button>
	<button class="carousel-prev" type="button" aria-label="Foto precedente" hidden>&#8249;</button>
	<button class="carousel-next" type="button" aria-label="Foto successiva" hidden>&#8250;</button>
</section>

<style>
	.photo-carousel {
		position: relative;
		margin: 0 auto;
		max-width: 800px;
	}

	.carousel-track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}

	.carousel-track::-webkit-scrollbar {
		display: none;
	}

	.carousel-slide {
		flex: 0 0 100%;
		scroll-snap-align: center;
		display: flex;
		flex-direction: column;
	}

	.carousel-slide img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}

	.carousel-caption {
		margin: 0;
		padding: 0.5em 0;
		text-align: center;
		font-size: 90%;
	}

	.carousel-toggle,
	.carousel-prev,
	.carousel-next {
		position: absolute;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 50%;
		background: rgba(0, 33, 71, 0.65);
		color: #fff;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
	}

	.carousel-toggle:hover,
	.carousel-prev:hover,
	.carousel-next:hover {
		background: #2a7fff;
	}

	.carousel-prev,
	.carousel-next {
		top: 50%;
		transform: translateY(-50%);
	}

	.carousel-prev {
		left: 0.5rem;
	}

	.carousel-next {
		right: 0.5rem;
	}

	.carousel-toggle {
		top: 0.5rem;
		right: 0.5rem;
		font-size: 0.9rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-track {
			scroll-behavior: auto;
		}
	}
</style>

<script>
	// Progressive enhancement: the carousel already scrolls and snaps without
	// this, so the buttons stay hidden until the script runs.
	const AUTOPLAY_MS = 5000;
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLElement>('.photo-carousel').forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>('.carousel-track');
		const toggle = carousel.querySelector<HTMLButtonElement>('.carousel-toggle');
		const prev = carousel.querySelector<HTMLButtonElement>('.carousel-prev');
		const next = carousel.querySelector<HTMLButtonElement>('.carousel-next');
		if (!track || !toggle || !prev || !next) return;

		const count = track.children.length;
		prev.hidden = false;
		next.hidden = false;

		const step = (direction: number) => {
			// Count from the nearest slide, not scrollLeft itself, so a click
			// during a smooth scroll still lands on a slide. Wraps at both ends.
			const width = track.clientWidth;
			const current = Math.round(track.scrollLeft / width);
			const target = (current + direction + count) % count;
			track.scrollTo({ left: target * width });
		};

		// `paused` is the visitor's choice, shown on the toggle; the others only
		// hold autoplay back while they last.
		let paused = false;
		let hovered = false;
		let visible = false;
		let timer: number | undefined;

		const update = () => {
			toggle.hidden = reduced.matches;
			toggle.innerHTML = paused ? '&#9654;' : '&#10074;&#10074;';
			toggle.setAttribute('aria-label', paused ? 'Avvia le foto' : 'Metti in pausa le foto');

			const running = !paused && !hovered && visible && !document.hidden && !reduced.matches;
			// Announce slide changes only when the visitor caused them.
			track.setAttribute('aria-live', running ? 'off' : 'polite');
			if (running && timer === undefined) {
				timer = window.setInterval(() => step(1), AUTOPLAY_MS);
			} else if (!running && timer !== undefined) {
				window.clearInterval(timer);
				timer = undefined;
			}
		};

		prev.addEventListener('click', () => step(-1));
		next.addEventListener('click', () => step(1));
		toggle.addEventListener('click', () => {
			paused = !paused;
			update();
		});

		// Keyboard focus stops autoplay until the visitor restarts it with the
		// toggle, which is why focusing the toggle itself doesn't count.
		carousel.addEventListener('focusin', (event) => {
			if (event.target === toggle) return;
			paused = true;
			update();
		});

		// Pointer events cover touch too: a finger "leaves" when it lifts.
		carousel.addEventListener('pointerenter', () => {
			hovered = true;
			update();
		});
		carousel.addEventListener('pointerleave', () => {
			hovered = false;
			update();
		});

		// No point turning slides (and fetching their lazy images) nobody sees.
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			update();
		}).observe(carousel);
		document.addEventListener('visibilitychange', update);
		reduced.addEventListener('change', update);

		update();
	});
</script>
