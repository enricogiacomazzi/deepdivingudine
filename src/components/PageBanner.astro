---
import type { PageMeta } from '../data/pages';

interface Props {
	page: PageMeta;
}

const { page } = Astro.props;
---

{/*
	Hero strip under the header. The image and its focal point come from
	src/data/pages.ts and are passed to the stylesheet as custom properties, so
	every page shares one rule instead of the per-page selectors the old theme had.
*/}
<div
	class:list={['page-banner', `banner-${page.bannerSize}`]}
	style={`--banner-image: url('${page.bannerImage}'); --banner-position: ${page.bannerPosition};`}
>
	<slot />
</div>
